{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ApplyJobsInTheProdEnvironmentOfOneRepository",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::111122223333:oidc-provider/token.actions.githubusercontent.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
          "token.actions.githubusercontent.com:sub": "repo:example-org/bedrock-platform:environment:prod",
          "token.actions.githubusercontent.com:repository_id": "REPLACE-WITH-NUMERIC-REPOSITORY-ID",
          "token.actions.githubusercontent.com:repository_owner_id": "REPLACE-WITH-NUMERIC-OWNER-ID",
          "token.actions.githubusercontent.com:ref": "refs/heads/main"
        }
      }
    }
  ]
}
